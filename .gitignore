# Gradle / ModDevGradle
# build.gradle is deliberately NOT ignored: it is the build script and is tracked.
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Dev-run game directory (worlds, logs, crash reports, options)
run/
run/

# Port tooling and scratch output - local only, not part of the mod.
# tools/ holds the throwaway analysis and migration scripts; *.log / *.txt / *.err are
# compiler and runtime transcripts plus one-off scratch files.
tools/
*.log
errs*.txt
*.err

# Sources extracted from jars for reference during the port. Any .j* directory is a scratch
# extraction; add new ones here never again.
.j*/
.mdgx/
.mdgsrc/
.abstractprobe/

### IntelliJ IDEA ###
out/
!**/src/main/**/out/
!**/src/test/**/out/
*.ipr
*.iws
*.iml
.idea

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### VS Code ###
.vscode/

